{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/json {:git/sha "4c55a247b020bfb1c7b5b09f9df8f3fa5601a207"}
       org.clojure/clojure {:mvn/version "1.12.4"}
        ;; sibling gftdcojp repo, local/root dep (same pattern as cloud-itonami's
        ;; io.github.gftdcojp/cloud-mamori dependency) — reuse the already-proven
        ;; job normalization + kotoba-queue submit/poll wire protocol instead of
        ;; re-deriving it here.
        io.github.gftdcojp/cloud-murakumo {:local/root "../../network-awai/cloud-murakumo"}
        ;; 座標二重化の解消（ADR-2608081000）。この lib は依存グラフの中で
        ;; :local/root と :git/sha の両方で宣言されており、どちらも推移依存に
        ;; 落ちるため tools.deps が 'Unable to compare versions' で classpath を
        ;; 組めなかった（= この repo の suite は 1 度も走っていなかった）。
        ;; top-level に置けば深さ 1 で勝つ。
        ;; The repository was renamed kotoba-lang/ed25519 -> kotoba-lang/org-ietf-ed25519.
        ;; The :local/root already points at the new name; only the coordinate
        ;; symbol still said the old one. Two symbols naming one repository are
        ;; two libraries to tools.deps, so ed25519.core was landing on the
        ;; classpath twice -- once from this checkout, once from the
        ;; org-ietf-ed25519 :git/sha another dependency in the closure pins.
        io.github.kotoba-lang/org-ietf-ed25519
        {:local/root "../../kotoba-lang/org-ietf-ed25519"}
        }
 :aliases
 {:run {:main-opts ["-m" "rig.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
